<!-- Chocolatier / Kimbie palette. Uses Flow Launcher 2.1.4 bundled base styles. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <CornerRadius x:Key="ItemRadius">4</CornerRadius>
    <Thickness x:Key="ItemMargin">4 0 4 0</Thickness>
    <Thickness x:Key="ResultMargin">0 0 0 4</Thickness>
    <system:Double x:Key="ResultItemHeight">48</system:Double>
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor">#4e3819</SolidColorBrush>
    <Style x:Key="WindowStyle" BasedOn="{StaticResource BaseWindowStyle}" TargetType="{x:Type Window}">
        <Setter Property="Width" Value="580" />
    </Style>
    <Style x:Key="WindowBorderStyle" BasedOn="{StaticResource BaseWindowBorderStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#221a0f" />
        <Setter Property="BorderBrush" Value="#f4aa2b" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="PreviewWindowBorderStyle" BasedOn="{StaticResource BaseWindowBorderStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#221a0f" />
        <Setter Property="BorderBrush" Value="#f4aa2b" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="QueryBoxStyle" BasedOn="{StaticResource BaseQueryBoxStyle}" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#d3af86" />
        <Setter Property="CaretBrush" Value="#f4aa2b" />
        <Setter Property="SelectionBrush" Value="#4e3819" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="12 4 0 4" />
        <Setter Property="Padding" Value="0 0 12 0" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="QuerySuggestionBoxStyle" BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#aa8c6b" />
        <Setter Property="CaretBrush" Value="#f4aa2b" />
        <Setter Property="SelectionBrush" Value="#4e3819" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="12 4 0 4" />
        <Setter Property="Padding" Value="0 0 12 0" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="ItemTitleStyle" BasedOn="{StaticResource BaseItemTitleStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#d3af86" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="ItemTitleSelectedStyle" BasedOn="{StaticResource BaseItemTitleSelectedStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#d3af86" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="ItemSubTitleStyle" BasedOn="{StaticResource BaseItemSubTitleStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#aa8c6b" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="ItemSubTitleSelectedStyle" BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#aa8c6b" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="ItemHotkeyStyle" BasedOn="{StaticResource BaseItemHotkeyStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#aa8c6b" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="ItemHotkeySelectedStyle" BasedOn="{StaticResource BaseItemHotkeySelectedStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#f4aa2b" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="PreviewItemTitleStyle" BasedOn="{StaticResource BasePreviewItemTitleStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#d3af86" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="PreviewItemSubTitleStyle" BasedOn="{StaticResource BasePreviewItemSubTitleStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#aa8c6b" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
    </Style>
    <Style x:Key="ItemGlyph" BasedOn="{StaticResource BaseGlyphStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#d3af86" />
    </Style>
    <Style x:Key="ItemGlyphSelectedStyle" BasedOn="{StaticResource BaseGlyphSelectedStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#f4aa2b" />
    </Style>
    <Style x:Key="ItemNumberStyle" BasedOn="{StaticResource BaseItemNumberStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#aa8c6b" />
    </Style>
    <Style x:Key="PreviewGlyph" BasedOn="{StaticResource BasePreviewGlyph}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#d3af86" />
    </Style>
    <Style x:Key="ClockBox" BasedOn="{StaticResource BaseClockBox}" TargetType="{x:Type TextBlock}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
        <Setter Property="Foreground" Value="#aa8c6b" />
    </Style>
    <Style x:Key="DateBox" BasedOn="{StaticResource BaseDateBox}" TargetType="{x:Type TextBlock}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="FontFamily" Value="JetBrainsMono NF, Cascadia Mono" />
        <Setter Property="Foreground" Value="#aa8c6b" />
    </Style>
    <Style x:Key="ItemHotkeyBGStyle" BasedOn="{StaticResource BaseItemHotkeyBGStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#4e3819" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4 2" />
        <Setter Property="Margin" Value="8 0" />
    </Style>
    <Style x:Key="ItemHotkeyBGSelectedStyle" BasedOn="{StaticResource BaseItemHotkeyBGSelectedStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#4e3819" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4 2" />
        <Setter Property="Margin" Value="8 0" />
    </Style>
    <Style x:Key="PendingLineStyle" BasedOn="{StaticResource BasePendingLineStyle}" TargetType="{x:Type Line}">
        <Setter Property="Stroke" Value="#f4aa2b" />
    </Style>
    <Style x:Key="SearchIconStyle" BasedOn="{StaticResource BaseSearchIconStyle}" TargetType="{x:Type Path}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Fill" Value="#aa8c6b" />
    </Style>
    <Style x:Key="SeparatorStyle" BasedOn="{StaticResource BaseSeparatorStyle}" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#4e3819" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12 0 12 4" />
    </Style>
    <Style x:Key="PreviewBorderStyle" BasedOn="{StaticResource BasePreviewBorderStyle}" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#4e3819" />
    </Style>
    <Style x:Key="ScrollBarStyle" BasedOn="{StaticResource BaseScrollBarStyle}" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="0" />
    </Style>
    <Style x:Key="ThumbStyle" BasedOn="{StaticResource BaseThumbStyle}" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="#aa8c6b" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.Foreground" Value="#f4aa2b" />
        <Setter Property="Inline.FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
